#include "minishell.h"

char	*trim_whitespace(char	*prompt)

char	*ft_parse(char* prompt)
{
	char **str;
	/*Shell operator precedence (from highest to lowest):
		Parentheses ( ... )
		Redirections (>, <, >>, <<)
		Pipes (|)
		Logical operators (&&, ||)
		Sequence operators (;, &)
	*/
	// 1. Trim whitespace
    // 2. If parentheses: find matching, recurse
    // 3. Split by logical operators (lowest precedence)
    // 4. If no logical operators: split by pipes
    // 5. If no pipes: parse command + redirections
	str = trim_whitespace(prompt);
/* 	detect_operator()
	if (ac >= 1)
		return (0);
	i = 0;
	while (i == ac)
	{
		av[i];
		i++;
	}
	return (1); */
	return (str);
}

char	**trim_whitespace(char	*prompt)
{
	char	*out;
	int		i;

	i = 0;
	while (prompt[i] != '\0')
	{
		if (prompt[i - 1] == ' ' || prompt[i - 1] == ' ')
			i++;
		out[i] = prompt[i];
		i++;
	}
	out[i] = '\0';
	return (out);
}
